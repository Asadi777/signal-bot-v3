# Phase 0A needs NO credentials: every source used is public market data.
# This file documents optional knobs only. Never commit a filled-in .env.

# Root for all research outputs (raw / normalized / reports / manifests).
PREPUMP_DATA_ROOT=./data

# Log level: DEBUG | INFO | WARNING | ERROR
PREPUMP_LOG_LEVEL=INFO

# Global outbound request budget (requests per second, across all sources).
PREPUMP_RATE_LIMIT_RPS=4.0

# Bounded retry policy.
PREPUMP_MAX_RETRIES=5
PREPUMP_BACKOFF_BASE_SECONDS=1.0
PREPUMP_BACKOFF_MAX_SECONDS=60.0

# Override archive base URL. Supports file:// for fully offline runs.
# PREPUMP_BINANCE_VISION_BASE_URL=https://data.binance.vision
